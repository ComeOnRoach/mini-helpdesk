{
  "name": "@helpdesk/api",
  "version": "0.0.0",
  "private": true,
  "description": "Mini Helpdesk API (NestJS)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "seed": "ts-node src/seed/run-seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^12.2.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
