DB_HOST=localhost
DB_PORT=3306
DB_USER=helpdesk
DB_PASSWORD=helpdesk
DB_ROOT_PASSWORD=root
DB_NAME=helpdesk
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
UPLOAD_DIR=
MAX_UPLOAD_BYTES=5242880
VITE_API_URL=http://localhost:3000
# Front-end analytics requests (POST /api/analytics/events); anything but "true" turns them off
VITE_ANALYTICS_ENABLED=true

# Playwright (e2e/, future; see e2e/README.md). Not read by the API or web app.
BASE_URL=http://localhost:5173
API_URL=http://localhost:3000

# Host port of the web container in docker-compose.prod.yml (nginx listens on 8080 inside)
WEB_PORT=5173

# Content-Security-Policy header (API, web dev/preview server and the nginx web container of docker-compose.prod.yml);
# anything but "true" turns it off
CSP_ENABLED=false
# "true" sends Content-Security-Policy-Report-Only (violations are only reported, not blocked)
CSP_REPORT_ONLY=false

# Test API (T7.3): /api/test/reset|seed|users; only when true or NODE_ENV=test, never in production
ENABLE_TEST_API=false
# Secret for the x-test-key header (required when the Test API is on; no default).
# Playwright (e2e/) sends the same value in x-test-key.
TEST_API_KEY=

# Instability modes (off by default): delay in ms (0-60000) and share of failed GET /api/tickets (0-1)
SLOW_API_MS=0
FLAKY_RATE=0
