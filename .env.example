DB_HOST=localhost
DB_PORT=3306
DB_USER=helpdesk
DB_PASSWORD=helpdesk
DB_ROOT_PASSWORD=root
DB_NAME=helpdesk
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
UPLOAD_DIR=
MAX_UPLOAD_BYTES=5242880
VITE_API_URL=http://localhost:3000
# Front-end analytics requests (POST /api/analytics/events); anything but "true" turns them off
VITE_ANALYTICS_ENABLED=true
# Host port of the web container in docker-compose.prod.yml (nginx listens on 8080 inside)
WEB_PORT=5173
